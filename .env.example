# docker compose 用的环境变量（复制成 .env 后按需修改）
#   cp .env.example .env

TZ=Asia/Shanghai

# 宿主机发布端口（只绑 127.0.0.1，由 Nginx/Caddy 反代进来）
RELAY_PUBLISH_PORT=8800

# 子目录反代时填前缀，例如 /llmrelay；根目录部署留空
# 注意：设了这里，控制台「设置 → 访问路径」就会被锁定
RELAY_BASE_PATH=

# 镜像 tag
RELAY_VERSION=1.0.0

# GeoIP 数据库（概览页「地域访问地图」用，可选）
# 下载 GeoLite2-City.mmdb（MaxMind 免费账号：https://www.maxmind.com/en/geolite2）
# 放到 RELAY_DATA_DIR（默认 ./data/）下即可；也可指定任意路径，例如 ./geoip/GeoLite2-City.mmdb
# 不配置时该功能自动关闭（页面显示配置提示），其他功能不受影响
RELAY_GEOIP_DB=

